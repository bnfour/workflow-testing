<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Bnfour.WorkflowTesting.CompletelyExternal</RootNamespace>
  </PropertyGroup>
  <!-- place a copy in "main" project's references folder on build -->
  <Target Name="Install reference locally" AfterTargets="Build">
    <Copy SourceFiles="$(OutputPath)$(AssemblyName).dll" DestinationFolder="$(MSBuildThisFileDirectory)/../references" />
  </Target>
</Project>
